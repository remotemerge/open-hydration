{
  "name": "@remotemerge/drink-water",
  "description": "Drink Water is an open source browser extension to keep you hydrated.",
  "version": "3.0.1",
  "homepage": "https://madansapkota.com",
  "author": {
    "name": "Madan Sapkota",
    "email": "contact+github@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "license": "MIT",
  "private": false,
  "keywords": [
    "chrome",
    "drink",
    "extension",
    "water"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:remotemerge/drink-water.git"
  },
  "bugs": {
    "email": "contact+github@madansapkota.com",
    "url": "https://github.com/remotemerge/drink-water/issues"
  },
  "engines": {
    "node": ">=14"
  },
  "browserslist": [
    "chrome >= 88"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "create:archive": "rm -rf ./dist/*.txt && node ./archive.js",
    "create:manifest": "node ./manifest.js",
    "webpack:dev": "webpack --mode=development --node-env development",
    "webpack:pro": "webpack --mode=production --node-env production",
    "watch": "yarn dev --watch",
    "dev": "yarn create:manifest && yarn webpack:dev",
    "build": "yarn create:manifest && yarn webpack:pro",
    "package": "yarn clean && yarn build && yarn create:archive"
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.14.8",
    "@babel/preset-react": "^7.14.5",
    "@types/archiver": "^5.1.1",
    "@types/chrome": "^0.0.149",
    "archiver": "^5.3.0",
    "autoprefixer": "^10.3.1",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^6.2.0",
    "cssnano": "^5.0.7",
    "cssnano-preset-advanced": "^5.1.3",
    "eslint": "^7.32.0",
    "eslint-plugin-react": "^7.24.0",
    "html-webpack-plugin": "^5.3.2",
    "mini-css-extract-plugin": "^2.1.0",
    "postcss": "^8.3.6",
    "postcss-loader": "^6.1.1",
    "prettier": "^2.3.2",
    "sass": "^1.37.0",
    "sass-loader": "^12.1.0",
    "style-loader": "^3.2.1",
    "ts-loader": "^9.2.4",
    "typescript": "^4.3.5",
    "webpack": "^5.47.1",
    "webpack-cli": "^4.7.2",
    "webpack-merge": "^5.8.0"
  }
}
