{
  "name": "@cixware/cereact",
  "app_name": "React Extension",
  "app_name_short": "Extension",
  "description": "The chrome extension base using ReactJS.",
  "version": "1.0.4",
  "homepage": "https://cixware.io",
  "author": {
    "name": "Madan Sapkota",
    "email": "code@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "chrome",
    "extension",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:workapps/cereact.git"
  },
  "engines": {
    "node": ">=12"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/* ./*.zip ./*.7z",
    "archive": "node ./archive.js",
    "manifest:dev": "cross-env NODE_ENV=development node ./manifest.js",
    "manifest:pro": "cross-env NODE_ENV=production node ./manifest.js",
    "webpack:dev": "cross-env NODE_ENV=development webpack --mode=development",
    "webpack:pro": "cross-env NODE_ENV=production webpack --mode=production",
    "dev": "yarn manifest:dev && yarn webpack:dev",
    "build": "yarn manifest:pro && yarn webpack:pro",
    "package": "yarn clean && yarn build && yarn archive"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@types/chrome": "^0.0.145",
    "archiver": "^5.3.0",
    "autoprefixer": "^10.2.6",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.6",
    "cssnano": "^5.0.6",
    "eslint": "^7.28.0",
    "eslint-plugin-react": "^7.24.0",
    "fibers": "^5.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.3.1",
    "mini-css-extract-plugin": "^1.6.0",
    "node-sass": "^6.0.0",
    "postcss": "^8.3.1",
    "postcss-loader": "^6.0.0",
    "sass": "^1.34.1",
    "sass-loader": "^12.0.0",
    "ts-loader": "^9.2.3",
    "typescript": "^4.3.2",
    "webpack": "^5.38.1",
    "webpack-cli": "^4.7.2",
    "webpack-merge": "^5.8.0"
  }
}
