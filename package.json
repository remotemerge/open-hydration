  "repository": {
    "type": "git",
    "url": "git+https://github.com/remotemerge/open-hydration.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
