{
  "name": "@cixware/cereact",
  "app_name": "React Extension",
  "app_name_short": "Extension",
  "description": "The chrome extension base using ReactJS.",
  "version": "3.0.1",
  "homepage": "https://cixware.io",
  "author": {
    "name": "Madan Sapkota",
    "email": "code@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "chrome",
    "extension",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:remotemerge/cereact.git"
  },
  "engines": {
    "node": ">=12"
  },
  "browserslist": [
    "chrome >= 88"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/* ./dist/*.txt",
    "archive": "node ./archive.js",
    "manifest:dev": "cross-env NODE_ENV=development node ./manifest.js",
    "manifest:pro": "cross-env NODE_ENV=production node ./manifest.js",
    "webpack:dev": "cross-env NODE_ENV=development webpack --mode=development",
    "webpack:pro": "cross-env NODE_ENV=production webpack --mode=production",
    "dev": "yarn manifest:dev && yarn webpack:dev",
    "build": "yarn manifest:pro && yarn webpack:pro",
    "package": "yarn clean && yarn build && yarn archive"
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.14.8",
    "@babel/preset-react": "^7.14.5",
    "@types/archiver": "^5.1.1",
    "@types/chrome": "^0.0.149",
    "archiver": "^5.3.0",
    "autoprefixer": "^10.3.1",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.2.0",
    "cssnano": "^5.0.7",
    "eslint": "^7.31.0",
    "eslint-plugin-react": "^7.24.0",
    "fibers": "^5.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.3.2",
    "mini-css-extract-plugin": "^2.1.0",
    "postcss": "^8.3.6",
    "postcss-loader": "^6.1.1",
    "prettier": "^2.3.2",
    "sass": "^1.36.0",
    "sass-loader": "^12.1.0",
    "style-loader": "^3.2.1",
    "ts-loader": "^9.2.4",
    "typescript": "^4.3.5",
    "webpack": "^5.47.1",
    "webpack-cli": "^4.7.2",
    "webpack-merge": "^5.8.0"
  }
}
