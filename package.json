    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "engines": {
    "bun": ">=1.3.14 <2.0.0"
  }
