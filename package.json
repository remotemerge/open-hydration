{
  "name": "@cixware/cereact",
  "app_name": "React Extension",
  "app_name_short": "Extension",
  "description": "The chrome extension base using ReactJS.",
  "version": "1.0.1",
  "homepage": "https://cixware.io",
  "author": {
    "name": "Madan Sapkota",
    "email": "code@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "chrome",
    "extension",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:workapps/cereact.git"
  },
  "engines": {
    "node": ">=12"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/* ./*.zip ./*.7z",
    "manifest": "node ./manifest.js",
    "archive": "node ./archive.js",
    "dev": "cross-env NODE_ENV=development webpack --config webpack.config.js --mode=development",
    "build": "yarn clean && cross-env NODE_ENV=production webpack --config webpack.config.js --mode=production --progress --hide-modules",
    "package": "yarn clean && yarn build && yarn manifest && yarn archive"
  },
  "dependencies": {
    "axios": "^0.19.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-router": "^5.1.2",
    "react-router-dom": "^5.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "archiver": "^4.0.1",
    "autoprefixer": "^9.7.6",
    "babel-loader": "^8.1.0",
    "copy-webpack-plugin": "^5.1.1",
    "cross-env": "^7.0.2",
    "css-loader": "^3.5.2",
    "cssnano": "^4.1.10",
    "eslint": "^6.8.0",
    "eslint-plugin-react": "^7.19.0",
    "fibers": "^4.0.2",
    "file-loader": "^6.0.0",
    "html-webpack-plugin": "^4.2.0",
    "mini-css-extract-plugin": "^0.9.0",
    "node-sass": "^4.13.1",
    "postcss-loader": "^3.0.0",
    "sass": "^1.26.3",
    "sass-loader": "^8.0.2",
    "ts-loader": "^7.0.0",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.10.3",
    "webpack-merge": "^4.2.2"
  }
}
