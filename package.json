{
  "name": "@remotemerge/drink-water",
  "description": "Stay hydrated with timely water intake notifications to refresh and energize you throughout the day!",
  "version": "3.0.1",
  "homepage": "https://madansapkota.com",
  "license": "UNLICENSED",
  "author": {
    "name": "Madan Sapkota",
    "role": "Maintainer",
    "email": "contact+gh@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remotemerge/drink-water.git"
  },
  "bugs": {
    "url": "https://github.com/remotemerge/drink-water/issues"
  },
  "browserslist": [
    "chrome >= 88"
  ],
  "engines": {
    "node": ">=20.14 <21.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  },
  "type": "module",
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx,vue}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx,vue}' --fix",
    "make:manifest": "tsx ./makers/manifest.ts",
    "make:archive": "tsx ./makers/archive.ts",
    "dev": "npm run make:manifest && vite build --watch",
    "build": "npm run make:manifest && vite build",
    "package": "npm run build && npm run make:archive"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3"
  }
}
