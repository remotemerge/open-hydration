{
  "name": "@cixware/cereact",
  "app_name": "React Extension",
  "app_name_short": "Extension",
  "description": "The chrome extension base using ReactJS.",
  "version": "1.0.2",
  "homepage": "https://cixware.io",
  "author": {
    "name": "Madan Sapkota",
    "email": "code@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "chrome",
    "extension",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:workapps/cereact.git"
  },
  "engines": {
    "node": ">=12"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/* ./*.zip ./*.7z",
    "archive": "node ./archive.js",
    "manifest:dev": "cross-env NODE_ENV=development node ./manifest.js",
    "manifest:pro": "cross-env NODE_ENV=production node ./manifest.js",
    "webpack:dev": "cross-env NODE_ENV=development webpack --mode=development",
    "webpack:pro": "cross-env NODE_ENV=production webpack --mode=production",
    "dev": "yarn manifest:dev && yarn webpack:dev",
    "build": "yarn manifest:pro && yarn webpack:pro",
    "package": "yarn clean && yarn build && yarn archive"
  },
  "dependencies": {
    "axios": "^0.19.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.11.1",
    "@babel/preset-react": "^7.10.4",
    "@types/chrome": "^0.0.122",
    "archiver": "^5.0.0",
    "autoprefixer": "^9.8.6",
    "babel-loader": "^8.1.0",
    "copy-webpack-plugin": "^6.0.3",
    "cross-env": "^7.0.2",
    "css-loader": "^4.2.1",
    "cssnano": "^4.1.10",
    "eslint": "^7.6.0",
    "eslint-plugin-react": "^7.20.5",
    "fibers": "^5.0.0",
    "file-loader": "^6.0.0",
    "html-webpack-plugin": "^4.3.0",
    "mini-css-extract-plugin": "^0.10.0",
    "node-sass": "^4.14.1",
    "postcss-loader": "^3.0.0",
    "sass": "^1.26.10",
    "sass-loader": "^9.0.3",
    "ts-loader": "^8.0.2",
    "typescript": "^3.9.7",
    "webpack": "^4.44.1",
    "webpack-cli": "^3.3.12",
    "webpack-merge": "^5.1.1"
  }
}
